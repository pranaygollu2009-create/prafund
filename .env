# Local placeholder credentials.
# The app refuses to boot without Supabase env vars, and on Lovable these are
# provisioned by Lovable Cloud. Replace with your real project values to get
# sign-in, cloud saves, XP sync and the global stats counters working:
#   Lovable editor -> Cloud -> Settings -> copy URL, publishable key, service role key.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_dev_placeholder

# Server-side (SSR / server functions). Never commit real values of these.
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_dev_placeholder
SUPABASE_SERVICE_ROLE_KEY=sb_secret_local_dev_placeholder

# Supabase Edge Function that proxies Yahoo Finance quotes (empty = simulated fallback).
# Set after deploying supabase/functions/market-quotes, e.g.:
# VITE_MARKET_QUOTES_URL=https://<project-ref>.supabase.co/functions/v1/market-quotes
VITE_MARKET_QUOTES_URL=
