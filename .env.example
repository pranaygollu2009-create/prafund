# Copy to .env and fill in. VITE_* values are baked into the client at build time.

# Supabase (Lovable Cloud -> Settings in your lovable.dev project)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live market feed: URL of the deployed `market-quotes` edge function
# (supabase/functions/market-quotes). Leave empty to run on the simulated fallback.
# Example: https://<project-ref>.supabase.co/functions/v1/market-quotes
VITE_MARKET_QUOTES_URL=
